# Connexion PostgreSQL (obligatoire)
DATABASE_URL=postgresql://poseidon:poseidon@localhost:5432/poseidon

# Paramètres d'analyse (valeurs par défaut)
MAX_POWER=250
MIN_STABLE_POWER=50
STABLE_WINDOW_S=30
STABLE_STD_THRESHOLD=5
MIN_STABLE_DURATION_S=60

# FTP de référence en watts pour le TSS (vide = FTP estimée sur la séance)
FTP_W=

# Import de fichiers depuis le dashboard (à n'activer que si l'accès est protégé)
POSEIDON_ENABLE_UPLOAD=false
